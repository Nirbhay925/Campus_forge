PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=campus_forge
DB_PORT=3306

# JWT Authentication Secret
JWT_SECRET=campus_forge_super_secret_jwt_key_2026_gehu
JWT_EXPIRES_IN=7d

# College Department Secret Passcode (Prevents students from registering as faculty)
FACULTY_SECRET_CODE=GEHU_FAC_2026

# ==============================================================================
# EMAIL DISPATCH CONFIGURATION (Nodemailer SMTP)
# ==============================================================================
# Option A: Any Gmail account (with Google App Password from myaccount.google.com/apppasswords):
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Option B: Custom Institutional / College SMTP Server:
# SMTP_HOST=smtp.gehu.ac.in
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=placement@gehu.ac.in
# SMTP_PASS=your_password
# SMTP_FROM=placement@gehu.ac.in
